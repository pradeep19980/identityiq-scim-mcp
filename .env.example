# Safe no-credential demo: fictional data only; writes always disabled
DEMO_MODE=true
MCP_TRANSPORT=stdio

# For a live connection set DEMO_MODE=false and fill in the required values privately.
# SCIM_BASE_URL=https://iiq.example.org/identityiq/scim/v2
# SCIM_TOKEN_URL=https://iiq.example.org/identityiq/oauth2/token
# SCIM_CLIENT_ID=
# SCIM_CLIENT_SECRET=
# SCIM_ACCESS_TOKEN=

SAILPOINT_ENABLE_WRITES=false
SAILPOINT_WRITE_USER_IDS=
SAILPOINT_ALLOWED_WORKFLOWS=
ALLOW_INSECURE_SCIM=false

# HTTP mode is for deployments BEHIND verified authenticated reverse proxies only.
# MCP_TRANSPORT=http
# MCP_HTTP_PROXY_AUTHENTICATED=false
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
